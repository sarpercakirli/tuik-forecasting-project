# =============================================================================
# .gitignore for R-based TÜİK Forecasting Project
# =============================================================================

# --- R System Files ---
.Rhistory
.RData
.Rproj.user/
*.Rproj
.Rprofile

# --- renv: keep renv.lock but ignore the local library ---
renv/library/
renv/staging/
renv/.cache/
renv/python/

# --- macOS System Files ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Windows System Files ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Temporary / Cache Files ---
*~
*.tmp
*.bak
*.swp
*.swo
*.log

# --- Knitr / R Markdown cache ---
*_cache/
*_files/
*.tex

# --- IDE Files ---
.idea/
*.suo
*.user

# --- RStudio ---
.Ruserdata

# --- Python (if any) ---
__pycache__/
*.py[cod]

# --- Data: no manually created or downloaded data files ---
# (All data comes from tuikr at runtime; no data folder needed)
data/

# --- Rendered HTML is committed intentionally; all other large outputs ---
# can be regenerated by running the Rmd
# (Comment out the line below if you want to commit the html to the repo)
# forecasting_project.html
